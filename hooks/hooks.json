{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--with-requirements",
              "${CLAUDE_PLUGIN_ROOT}/requirements.txt",
              "python3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/on_stop.py"
            ],
            "timeout": 60,
            "statusMessage": "Checking branch diff against its ADO ticket..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--with-requirements",
              "${CLAUDE_PLUGIN_ROOT}/requirements.txt",
              "python3",
              "${CLAUDE_PLUGIN_ROOT}/hooks/on_stop.py"
            ],
            "timeout": 60,
            "statusMessage": "Checking branch diff against its ADO ticket..."
          }
        ]
      }
    ]
  }
}
